{
  "manifest_version": 3,
  "name": "Claude 5-Hour Reset Automation",
  "version": "1.0.0",
  "description": "Local Safari automation that detects 5-hour reset windows and automatically submits configured prompt messages.",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "resources": [
        "content/injections/stream-watcher.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
